<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ToolHub</AssemblyName>
    <Product>ToolHub</Product>
    <Title>ToolHub</Title>
    <RootNamespace>Switchboard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ToolHub.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <Description>Windows 音频、亮度、定时关机与局域网互传</Description>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets\ToolHub.ico" /><Resource Include="Assets\ToolHub.png" /><Compile Remove="tests\**\*.cs" /><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <Content Include=".tools\ffmpeg\*" Link="tools\ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
