<Window x:Class="Switchboard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:controls="clr-namespace:Switchboard.Controls" Title="ToolHub · 音频输出" Width="1160" Height="790" MinWidth="1000" MinHeight="710" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" Icon="Assets/ToolHub.ico" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#BFC0B8" BorderThickness="1"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"><Grid Margin="20,0,0,0"><TextBlock Text="TOOLHUB" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="−" Width="46" BorderThickness="0" Click="MinimizeClick" AutomationProperties.Name="最小化"/><Button Content="□" Width="46" BorderThickness="0" Click="MaximizeClick" AutomationProperties.Name="最大化"/><Button Content="×" Width="46" BorderThickness="0" Click="HideClick" FontSize="18" ToolTip="后台运行" AutomationProperties.Name="后台运行"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0"><Grid Margin="20,28,20,24"><Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><Border Background="{StaticResource Accent}" Width="40" Height="40" HorizontalAlignment="Left"><Image Source="Assets/ToolHub.png" Stretch="Uniform" AutomationProperties.Name="ToolHub"/></Border><TextBlock Text="ToolHub" FontSize="19" FontWeight="Bold" Margin="0,16,0,0"/><TextBlock Text="WINDOWS TOOLS" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
        <Button x:Name="AudioNav" Style="{StaticResource Nav}" Grid.Row="1" Click="AudioNavClick" Background="{StaticResource Ink}" Foreground="White" BorderThickness="0" Padding="12,14"><Grid Width="100"><TextBlock Text="音频"/></Grid></Button>
        <Button x:Name="ShutdownNav" Style="{StaticResource Nav}" Grid.Row="2" Click="ShutdownNavClick" BorderThickness="0" Padding="12,14" Margin="0,4,0,0"><Grid Width="100"><TextBlock Text="定时关机"/></Grid></Button>
        <Button x:Name="BrightnessNav" Style="{StaticResource Nav}" Grid.Row="3" Click="BrightnessNavClick" BorderThickness="0" Padding="12,14" Margin="0,4,0,0"><Grid Width="100"><TextBlock Text="显示器亮度"/></Grid></Button>
        <Button x:Name="TransferNav" Style="{StaticResource Nav}" Grid.Row="4" Click="TransferNavClick" BorderThickness="0" Padding="12,14" Margin="0,4,0,0"><Grid Width="100"><TextBlock Text="局域网互传"/></Grid></Button>
        <Button x:Name="WirelessNav" Grid.Row="5" Style="{StaticResource Nav}" Click="WirelessNavClick" BorderThickness="0" Padding="12,14" Margin="0,4,0,0"><Grid Width="100"><TextBlock Text="设备电量"/></Grid></Button>
        <Button x:Name="ConversionNav" Grid.Row="6" Style="{StaticResource Nav}" Click="ConversionNavClick" BorderThickness="0" Padding="12,14" Margin="0,4,0,0"><Grid Width="100"><TextBlock Text="格式转换"/></Grid></Button>
        <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Grid.Row="7" Click="SettingsNavClick" BorderThickness="0" Padding="12,14" Margin="0,4,0,0"><Grid Width="100"><TextBlock Text="设置"/></Grid></Button>
        <StackPanel Grid.Row="9"><TextBlock Text="LOCAL / 0.7.0" FontFamily="Consolas" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
      </Grid></Border>
      <Grid Grid.Column="1" Margin="32,28,32,24">
        <Grid x:Name="AudioPage">
          <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock x:Name="AudioSectionLabel" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="音频输出" FontSize="35" FontWeight="Bold" Margin="-2,7,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0"><CheckBox x:Name="EnabledCheck" Content="全局快捷键" Checked="EnabledChanged" Unchecked="EnabledChanged"/><TextBlock x:Name="HotkeyStatus" FontSize="10" Foreground="{StaticResource Muted}" Margin="18,5,0,0"/></StackPanel></Grid>
          <Border Grid.Row="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,1" Margin="0,0,0,20"><Grid Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="作用范围" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TargetName" Text="没有前台应用" FontSize="16" FontWeight="SemiBold" Margin="0,6,14,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><Border Grid.Column="1" BorderBrush="{StaticResource Rule}" BorderThickness="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="ForegroundRadio" Content="前台应用" GroupName="Scope" Style="{StaticResource Segment}" Checked="ScopeChanged"/><RadioButton x:Name="AllRadio" Content="全部应用" GroupName="Scope" Style="{StaticResource Segment}" Checked="ScopeChanged"/></StackPanel></Border></Grid></Border>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions><Grid><TextBlock Text="输出设备" FontWeight="SemiBold"/><TextBlock x:Name="DeviceCount" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontFamily="Consolas"/></Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="DevicesList"><ItemsControl.ItemTemplate><DataTemplate><Border x:Name="DeviceBorder" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Index}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,4,0,0"/><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="系统默认" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,0,10,0" Visibility="{Binding IsDefault, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Volume, StringFormat={}{0}%}" FontSize="11" Foreground="{StaticResource Muted}" FontFamily="Consolas"/></StackPanel></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding InCycle, Mode=TwoWay}" Checked="CycleChanged" Unchecked="CycleChanged" ToolTip="设备循环" VerticalAlignment="Center" AutomationProperties.Name="设备循环"/><Button Grid.Column="3" Content="↗" FontSize="21" Width="36" Height="36" Padding="0" Click="RouteClick" Tag="{Binding Id}" ToolTip="音频输出" AutomationProperties.Name="音频输出"/></Grid></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="DeviceBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
              <TextBlock x:Name="EmptyDevices" Grid.Row="1" Text="没有可用的输出设备" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Grid Grid.Row="2" Margin="0,8,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Rectangle Width="6" Height="6" Fill="{StaticResource Muted}" Margin="0,0,7,0"/><TextBlock Text="设备循环" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel x:Name="CycleShortcuts" Orientation="Horizontal" HorizontalAlignment="Right"/></Grid>
            </Grid>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="快捷键预设" FontWeight="SemiBold"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PresetsPanel"/></ScrollViewer></Grid>
          </Grid>
          <Border Grid.Row="3" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Margin="0,20,0,0"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="设备音量" FontWeight="SemiBold"/><TextBlock x:Name="VolumeDeviceName" Margin="82,0,75,0" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="VolumeNumber" Text="—" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,-7,0,0" FontFamily="Segoe UI"/></Grid><Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VolumeChanged" VerticalAlignment="Center" AutomationProperties.Name="设备音量"/><CheckBox x:Name="MuteCheck" Grid.Column="1" Content="静音" Margin="12,0,0,0" Checked="MuteChanged" Unchecked="MuteChanged" VerticalAlignment="Center"/></Grid><Grid Grid.Row="2"><StackPanel x:Name="VolumeShortcuts" Orientation="Horizontal"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="步长" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><ComboBox x:Name="StepCombo" Width="72" Margin="8,0,0,0" SelectionChanged="StepChanged"><ComboBoxItem Content="1%" Tag="1"/><ComboBoxItem Content="2%" Tag="2"/><ComboBoxItem Content="5%" Tag="5"/><ComboBoxItem Content="10%" Tag="10"/></ComboBox></StackPanel></Grid></Grid></Border>
        </Grid>
        <Grid x:Name="ShutdownPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock x:Name="ShutdownSectionLabel" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="定时关机" FontSize="35" FontWeight="Bold" Margin="-2,7,0,0"/></StackPanel><TextBlock x:Name="ShutdownState" Text="未启用" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,20,0,0"/></Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="0,18"><Grid><TextBlock Text="关机方式" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><RadioButton x:Name="CountdownRadio" GroupName="ShutdownMode" Content="倒计时" Style="{StaticResource Segment}" Checked="ShutdownModeChanged"/><RadioButton x:Name="AtTimeRadio" GroupName="ShutdownMode" Content="指定时间" Style="{StaticResource Segment}" Checked="ShutdownModeChanged"/></StackPanel></Grid></Border>
            <Grid x:Name="ShutdownInputs" Margin="0,12,0,26">
              <StackPanel x:Name="CountdownInputs"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="小时" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/><TextBox x:Name="ShutdownHours" Text="0" FontSize="30" FontFamily="Consolas" MaxLength="3" TextChanged="ShutdownInputChanged" AutomationProperties.Name="倒计时小时"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="分钟" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/><TextBox x:Name="ShutdownMinutes" Text="30" FontSize="30" FontFamily="Consolas" MaxLength="2" TextChanged="ShutdownInputChanged" AutomationProperties.Name="倒计时分钟"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="秒" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/><TextBox x:Name="ShutdownSeconds" Text="0" FontSize="30" FontFamily="Consolas" MaxLength="2" TextChanged="ShutdownInputChanged" AutomationProperties.Name="倒计时秒"/></StackPanel>
              </Grid><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="15 分钟" Tag="15" Click="ShutdownPresetClick" Margin="0,0,10,0"/><Button Content="30 分钟" Tag="30" Click="ShutdownPresetClick" Margin="0,0,10,0"/><Button Content="1 小时" Tag="60" Click="ShutdownPresetClick" Margin="0,0,10,0"/><Button Content="2 小时" Tag="120" Click="ShutdownPresetClick"/></StackPanel></StackPanel>
              <Grid x:Name="AtTimeInputs" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="年" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/><controls:NumberWheel x:Name="ShutdownYear" Minimum="1900" Maximum="9999" Digits="4" Wrap="False" ValueChanged="ShutdownWheelChanged" AutomationProperties.Name="关机年份"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="月" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/><controls:NumberWheel x:Name="ShutdownMonth" Wrap="False" Minimum="1" Maximum="12" ValueChanged="ShutdownWheelChanged" AutomationProperties.Name="关机月份"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="日" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/><controls:NumberWheel x:Name="ShutdownDay" Wrap="False" Minimum="1" Maximum="31" ValueChanged="ShutdownWheelChanged" AutomationProperties.Name="关机日期"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="时" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/><controls:NumberWheel x:Name="ShutdownClockHour" Wrap="False" Minimum="0" Maximum="23" ValueChanged="ShutdownWheelChanged" AutomationProperties.Name="关机小时"/></StackPanel>
                <StackPanel Grid.Column="5"><TextBlock Text="分" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/><controls:NumberWheel x:Name="ShutdownClockMinute" Wrap="False" Minimum="0" Maximum="59" ValueChanged="ShutdownWheelChanged" AutomationProperties.Name="关机分钟"/></StackPanel>
              </Grid>
            </Grid>
            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,1" Padding="0,22,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ShutdownRemainingLabel" Text="倒计时" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ShutdownRemaining" Text="00:30:00" FontSize="60" FontFamily="Consolas" Margin="-3,10,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="关机时间" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ShutdownDueDate" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="ShutdownDueTime" Text="—" FontSize="28" FontFamily="Consolas" Margin="0,5,0,0"/></StackPanel></Grid></Border>
            <TextBlock x:Name="ShutdownError" Foreground="{StaticResource Accent}" TextWrapping="Wrap" MinHeight="20" Margin="0,14,0,0"/>
            <Grid Margin="0,8,0,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ShutdownPersistence" Text="后台运行及退出程序后仍有效" FontSize="11" Foreground="{StaticResource Muted}"/><CheckBox x:Name="ShutdownForce" Content="强制关机" Margin="0,10,0,0" Checked="ShutdownModeChanged" Unchecked="ShutdownModeChanged" ToolTip="到点强制关闭应用，未保存内容可能丢失"/><TextBlock Text="未保存内容可能丢失" Foreground="{StaticResource Accent}" FontSize="11" Margin="18,6,0,0" Visibility="{Binding IsChecked, ElementName=ShutdownForce, Converter={StaticResource BoolVisibility}}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="ShutdownCancel" Content="取消定时" IsEnabled="False" Click="ShutdownCancelClick" Margin="0,0,12,0"/><Button x:Name="ShutdownStart" Content="启用定时" Style="{StaticResource Nav}" Background="{StaticResource Accent}" Foreground="White" Padding="24,13" Click="ShutdownStartClick"/></StackPanel></Grid>
          </StackPanel></ScrollViewer>
        </Grid>
        <Grid x:Name="BrightnessPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock x:Name="BrightnessSectionLabel" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="显示器亮度" FontSize="35" FontWeight="Bold" Margin="-2,7,0,0"/></StackPanel><Button x:Name="BrightnessRefresh" Content="刷新" Width="80" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Click="BrightnessRefreshClick"/></Grid>
          <Border Grid.Row="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0"><TextBlock x:Name="BrightnessCount" Text="尚未检测" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="BrightnessDevices"><ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,24,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Number}" FontSize="40" FontFamily="Segoe UI" Foreground="{StaticResource Muted}" Margin="0,-6,0,0"/>
              <StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="主显示器" Foreground="{StaticResource Accent}" FontSize="10" Margin="12,5,0,0" Visibility="{Binding Primary, Converter={StaticResource BoolVisibility}}"/></StackPanel><TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="32" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,-4,0,0"/></Grid>
              <Grid Margin="0,22,0,0" IsEnabled="{Binding CanControl}"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button Content="−" Tag="-5" Click="BrightnessStepClick" Padding="0" Height="30" FontSize="19" AutomationProperties.Name="降低亮度"/><Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="14,0" AutomationProperties.Name="{Binding Name, StringFormat={}{0}亮度}"/><Button Grid.Column="2" Content="+" Tag="5" Click="BrightnessStepClick" Padding="0" Height="30" FontSize="18" AutomationProperties.Name="提高亮度"/></Grid>
              <Grid Margin="0,15,0,0"><StackPanel Orientation="Horizontal" IsEnabled="{Binding CanControl}"><Button Content="25%" Tag="25" Padding="12,5" Margin="0,0,8,0" Click="BrightnessPresetClick"/><Button Content="50%" Tag="50" Padding="12,5" Margin="0,0,8,0" Click="BrightnessPresetClick"/><Button Content="75%" Tag="75" Padding="12,5" Margin="0,0,8,0" Click="BrightnessPresetClick"/><Button Content="100%" Tag="100" Padding="12,5" Click="BrightnessPresetClick"/></StackPanel></Grid>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" MinHeight="18" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </StackPanel>
            </Grid></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <TextBlock x:Name="BrightnessEmpty" Grid.Row="2" Text="没有检测到显示器" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          <TextBlock x:Name="BrightnessPageError" Grid.Row="3" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </Grid>
        <Grid x:Name="TransferPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="76"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock x:Name="TransferSectionLabel" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="局域网互传" FontSize="35" FontWeight="Bold" Margin="-2,7,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" Margin="0,8,0,0"><TextBlock x:Name="TransferState" Text="启动中" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/><Button x:Name="TransferRetry" Content="重试" Visibility="Collapsed" Click="TransferRetryClick" Margin="0,8,0,0" Padding="12,4"/></StackPanel></Grid>
          <Border Grid.Row="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="设备名" FontSize="10" Foreground="{StaticResource Muted}"/><TextBox x:Name="TransferName" MaxLength="64" Padding="0,4" BorderThickness="0" FontSize="15" FontWeight="SemiBold" LostFocus="TransferNameChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="18,0"><TextBlock Text="本机地址" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TransferAddress" Text="—" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="Consolas" FontSize="12"/></StackPanel><Button Grid.Column="2" Content="复制地址" Padding="9,6" VerticalAlignment="Center" Click="TransferCopyAddress"/></Grid></Border>
          <Grid Grid.Row="2" Margin="0,22,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><Grid><TextBlock Text="附近设备" FontWeight="SemiBold"/><TextBlock x:Name="TransferPeerCount" Text="00" FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="78,0,0,0"/><Button Content="发现" HorizontalAlignment="Right" Padding="10,3" Margin="0,-5,0,5" Click="TransferDiscover"/></Grid><ListBox x:Name="TransferPeers" HorizontalContentAlignment="Stretch" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Button Click="TransferDeviceClick" Padding="12,16" HorizontalContentAlignment="Stretch" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Rule}" Background="Transparent"><Grid><StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><TextBlock Text="↗" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontSize="20"/></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBox x:Name="TransferPeerAddress" FontSize="11" Padding="7,5" ToolTip="设备地址，如 192.168.1.10:53318"/><Button Grid.Column="1" Content="添加" Padding="8,5" Margin="8,0,0,0" Click="TransferAddPeer"/></Grid></Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel AllowDrop="True" Drop="TransferDrop">
              <Grid Margin="0,0,0,10"><TextBlock Text="待发送内容" FontWeight="SemiBold"/><TextBlock x:Name="TransferFileCount" Text="0 项内容" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
              <ListBox x:Name="TransferFiles" Height="82" Background="Transparent" BorderBrush="{StaticResource Rule}" DisplayMemberPath="Details" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" Drop="TransferDrop"/>
              <Grid Margin="0,10,0,15"><StackPanel Orientation="Horizontal"><Button x:Name="TransferPick" Content="文件" Click="TransferAddFiles" Padding="12,6"/><Button x:Name="TransferFolderPick" Content="文件夹" Click="TransferAddFolder" Margin="8,0,0,0" Padding="10,6"/><Button x:Name="TransferTextPick" Content="文本" Click="TransferAddText" Margin="8,0,0,0" Padding="10,6"/><Button x:Name="TransferClipboardPick" Content="剪贴板" Click="TransferReadClipboard" Margin="8,0,0,0" Padding="10,6"/><Button x:Name="TransferClear" Content="清空" Margin="8,0,0,0" Click="TransferClearFiles" Padding="10,6"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="TransferOutgoingCancel" Content="取消传输" Visibility="Collapsed" Click="TransferCancelOutgoing" Padding="12,6"/></StackPanel></Grid>
              <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel><CheckBox x:Name="TransferAutoCopy" Content="接收后复制到剪贴板" Checked="TransferCopyChanged" Unchecked="TransferCopyChanged"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock x:Name="TransferDirectory" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,8,0"/><Button Grid.Column="1" Content="接收目录" Click="TransferChooseDirectory" Padding="7,4"/></Grid></StackPanel></Border>
              <Border x:Name="TransferIncoming" Visibility="Collapsed" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0" Margin="0,16,0,0" Padding="12,4"><StackPanel><TextBlock Text="接收请求" Foreground="{StaticResource Accent}" FontSize="10"/><TextBlock x:Name="TransferIncomingName" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="TransferIncomingDetails" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="接收" Click="TransferAccept" Padding="16,6"/><Button Content="拒绝" Click="TransferReject" Padding="16,6" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
              <TextBlock Text="最近传输" FontWeight="SemiBold" Margin="0,18,0,8"/><ItemsControl x:Name="TransferHistory"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="{Binding CopyLabel}" IsEnabled="{Binding CanCopy}" Click="TransferCopyFiles" Padding="8,4"/><Button Content="{Binding OpenLabel}" Click="TransferOpenFolder" Padding="8,4" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer>
          </Grid>
          <Border Grid.Row="3" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel><Grid><TextBlock x:Name="TransferProgressLabel" Text="" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,130,0"/><TextBlock x:Name="TransferProgressBytes" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid><ProgressBar x:Name="TransferProgressBar" Height="3" Margin="0,14,0,0" Maximum="100" Background="{StaticResource Rule}" Foreground="{StaticResource Accent}" BorderThickness="0"/></StackPanel></Border>
          <TextBlock Grid.Row="4" x:Name="TransferMessage" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap"/>
        </Grid>
        <Grid x:Name="WirelessPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock x:Name="WirelessSectionLabel" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="设备电量" FontSize="35" FontWeight="Bold" Margin="-2,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"><Button x:Name="WirelessHidden" Content="已隐藏" Visibility="Collapsed" Click="WirelessHiddenClick" Margin="0,0,10,0"/><Button x:Name="WirelessRefresh" Content="刷新" Click="WirelessRefreshClick"/></StackPanel></Grid>
          <Border Grid.Row="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><TextBlock x:Name="WirelessCount" Text="读取中" FontSize="11" Foreground="{StaticResource Muted}"/></Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="WirelessDevices"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,20" Background="Transparent" Loaded="WirelessCardLoaded" ContextMenuOpening="WirelessDeviceMenuOpening"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
            <Image Source="{Binding Icon}" Width="52" Height="52" Margin="0,0,22,0" VerticalAlignment="Top" Stretch="Uniform"/>
            <StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Padding="0,3"/><TextBlock Text="{Binding NativeName}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Level}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right"/><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,14,0,0" Visibility="{Binding MeterVisibility}" Foreground="{StaticResource Accent}" Background="{StaticResource Rule}" BorderThickness="0"/></StackPanel>
          </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <TextBlock x:Name="WirelessEmpty" Grid.Row="2" Text="没有发现设备电量" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="支持蓝牙、部分手柄和已适配的 2.4G 接收器。" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="WirelessError" Foreground="{StaticResource Accent}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/></StackPanel>
        </Grid>
        <Grid x:Name="ConversionPage" Visibility="Collapsed" AllowDrop="True" Drop="ConversionDrop">
          <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="ConversionSectionLabel" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="格式转换" FontSize="35" FontWeight="Bold" Margin="-2,7,0,0"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="ConvertCategories" Orientation="Horizontal"><RadioButton x:Name="ConvertImageRadio" Content="图片" GroupName="ConvertCategory" Tag="0" Style="{StaticResource Segment}" Checked="ConversionCategoryChanged"/><RadioButton x:Name="ConvertMediaRadio" Content="音视频" GroupName="ConvertCategory" Tag="1" Style="{StaticResource Segment}" Checked="ConversionCategoryChanged"/><RadioButton x:Name="ConvertDocumentRadio" Content="文档" GroupName="ConvertCategory" Tag="2" Style="{StaticResource Segment}" Checked="ConversionCategoryChanged"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ConvertClear" Content="清空" Click="ConversionClearClick" BorderThickness="0"/><Button x:Name="ConvertPick" Content="文件" Click="ConversionAddClick" Margin="8,0,0,0"/></StackPanel>
          </Grid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid><TextBlock Text="文件队列" FontWeight="SemiBold"/><TextBlock x:Name="ConvertQueueCount" Text="0 项内容" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/></Grid>
              <Border Grid.Row="1" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,1"><Grid>
                <TextBlock Text="文件支持拖放" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=ConvertJobs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="ConvertJobs"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" FontWeight="SemiBold"/><Grid Margin="0,6,0,0"><TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Status}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource Accent}"/></Grid><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="2" Margin="0,8,0,0" BorderThickness="0" Foreground="{StaticResource Accent}" Background="{StaticResource Rule}"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Output}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Output}" FontSize="10"/></StackPanel>
                    <StackPanel Grid.Column="1"><Button Content="×" Padding="8,2" BorderThickness="0" FontSize="18" Click="ConversionRemoveClick" ToolTip="移除文件" AutomationProperties.Name="移除文件"/><Button Content="↗" Padding="8,2" BorderThickness="0" Click="ConversionOpenDirectory" ToolTip="输出目录" AutomationProperties.Name="文件输出目录"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="已完成"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
                  </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
              </Grid></Border>
            </Grid>
            <StackPanel x:Name="ConvertControls" Grid.Column="2"><TextBlock Text="目标格式" FontWeight="SemiBold"/><ComboBox x:Name="ConvertFormat" DisplayMemberPath="Name" Margin="0,14,0,0" AutomationProperties.Name="转换目标格式"/>
              <StackPanel x:Name="ConvertQualityPanel" Margin="0,24,0,0"><Grid><TextBlock Text="图片质量" FontSize="11"/><TextBlock x:Name="ConvertQualityText" Text="90" HorizontalAlignment="Right" FontFamily="Consolas"/></Grid><Slider x:Name="ConvertQuality" Minimum="1" Maximum="100" Value="90" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,12,0,0" ValueChanged="ConversionQualityChanged" AutomationProperties.Name="图片质量"/></StackPanel>
              <TextBlock Text="输出目录" FontWeight="SemiBold" Margin="0,24,0,0"/><TextBox x:Name="ConvertDirectory" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" FontSize="11" Margin="0,12,0,0" AutomationProperties.Name="转换输出目录"/><Grid Margin="0,8,0,0"><Button Content="更改" Click="ConversionDirectoryClick" HorizontalAlignment="Left"/><Button Content="打开目录" Click="ConversionOpenDirectory" HorizontalAlignment="Right"/></Grid>
              <TextBlock x:Name="ConvertNote" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,24,0,0"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="3" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock x:Name="ConvertMessage" TextWrapping="Wrap" FontSize="12"/><ProgressBar x:Name="ConvertProgress" Maximum="100" Height="3" Margin="0,10,0,0" BorderThickness="0" Foreground="{StaticResource Accent}" Background="{StaticResource Rule}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ConvertCancel" Content="取消" Click="ConversionCancelClick" Margin="0,0,10,0" Visibility="Collapsed"/><Button x:Name="ConvertStart" Content="开始转换" Click="ConversionStartClick" Background="{StaticResource Ink}" Foreground="White" BorderThickness="0" Padding="24,12"/></StackPanel>
          </Grid></Border>
        </Grid>

        <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="SettingsSectionLabel" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="设置" FontSize="35" FontWeight="Bold" Margin="-2,7,0,0"/></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="0,20,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="运行" FontSize="19" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><CheckBox x:Name="StartupCheck" Content="开机启动" Checked="StartupChanged" Unchecked="StartupChanged"/><CheckBox x:Name="OverlayCheck" Content="快捷键浮层" Checked="OverlayChanged" Unchecked="OverlayChanged" Margin="0,14,0,0"/></StackPanel></Grid></Border>
<Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="栏目显示" FontSize="19" FontWeight="SemiBold"/><controls:HoldReorderPanel x:Name="SectionOptions" Grid.Column="1" OrderChanged="SectionOrderChanged" ToolTip="长按拖动排序"><CheckBox x:Name="ShowAudio" Tag="0" Content="音频" Checked="SectionVisibilityChanged" Unchecked="SectionVisibilityChanged"/><CheckBox x:Name="ShowShutdown" Tag="1" Content="定时关机" Checked="SectionVisibilityChanged" Unchecked="SectionVisibilityChanged"/><CheckBox x:Name="ShowBrightness" Tag="2" Content="显示器亮度" Checked="SectionVisibilityChanged" Unchecked="SectionVisibilityChanged"/><CheckBox x:Name="ShowTransfer" Tag="3" Content="局域网互传" Checked="SectionVisibilityChanged" Unchecked="SectionVisibilityChanged"/><CheckBox x:Name="ShowConversion" Tag="6" Content="格式转换" Checked="SectionVisibilityChanged" Unchecked="SectionVisibilityChanged"/><CheckBox x:Name="ShowWireless" Tag="5" Content="设备电量" Checked="SectionVisibilityChanged" Unchecked="SectionVisibilityChanged"/></controls:HoldReorderPanel></Grid></Border>
            <Grid Margin="0,20,0,8"><TextBlock Text="ToolHub 0.7.0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/><Button Content="退出" HorizontalAlignment="Right" Width="100" Click="ExitClick"/></Grid>
          </StackPanel></ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" Margin="0,0,7,0"/><TextBlock Text="本地运行" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="1" x:Name="StatusText" Text="就绪" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" x:Name="VolumeHint" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid></Border>
  </Grid></Border>
</Window>
